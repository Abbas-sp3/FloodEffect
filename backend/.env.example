# EvacX Backend Environment Configuration

# MongoDB Connection URL (Local or MongoDB Atlas)
MONGODB_URL=mongodb://localhost:27017

# Database Name
DATABASE_NAME=evacx

# Open-Meteo Real-time Weather API (KC Valley / Bangalore Coordinates)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast?latitude=12.935&longitude=77.645&current=rain,precipitation&timezone=Asia/Kolkata

# Path to STGCN model checkpoint file
STGCN_MODEL_PATH=./stgcn_checkpoint.pth

# Host & Port Settings
API_HOST=0.0.0.0
API_PORT=8000
